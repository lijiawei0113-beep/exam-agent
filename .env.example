# 复制本文件为 .env 并填入你的 DeepSeek API Key（.env 不要提交到 git）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# deepseek-flash 便宜快速，适合日常开发；deepseek-v4-pro 质量更高、更贵
DEEPSEEK_MODEL=deepseek-flash

# 结构化生成默认关闭思考模式（更快更省）；需要更强推理时改为 enabled
DEEPSEEK_THINKING=disabled

# SQLite 数据库位置
EXAM_DB_PATH=data/exam.db

# ---- 阶段四：检索 ----
# 向量模型：fastembed（本地，默认）/ api（OpenAI 兼容接口）/ none（只用 BM25）
EXAM_EMBEDDER=fastembed
EXAM_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 重排模型：none（默认，实验 3 显示重排在知识卡片上反而变差）/ fastembed
EXAM_RERANKER=none
EXAM_RERANK_MODEL=BAAI/bge-reranker-base
# 选 api 时填写（例如硅基流动），Key 同样不要提交到 git
EXAM_EMBED_API_BASE=https://api.siliconflow.cn/v1
EXAM_EMBED_API_MODEL=BAAI/bge-m3
EXAM_EMBED_API_KEY=
# 模型下载太慢或连不上 Hugging Face 时，可以取消下一行注释改用镜像
# HF_ENDPOINT=https://hf-mirror.com

# ---- 盲解 Agent 单独用另一个模型（可选） ----
# 命题员和盲解用同一个模型时，可能“两次答错得一样”（见 evals/real_defects.jsonl d019、d024）。
# 留空表示与命题员相同；例如：
# EXAM_BLIND_MODEL=deepseek-v4-pro
# EXAM_BLIND_THINKING=enabled
EXAM_BLIND_MODEL=
EXAM_BLIND_THINKING=
